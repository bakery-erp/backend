// Bakery ERP - Full schema
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  BAKER
  CAKE_WORKER
  CASHIER
  SAMBUSA_WORKER
  EMPLOYEE
}

enum Shift {
  DAY
  NIGHT
}

enum CategoryType {
  PRODUCED
  RESELL
}

enum UnitType {
  PIECE
  KG
  LITER
}

enum BatchStatus {
  PENDING_APPROVAL
  STARTED
  COMPLETED
  REJECTED
}

enum SessionStatus {
  OPEN
  PAUSED
  CLOSE_PENDING
  CLOSED
}

enum PaymentMethod {
  CASH
  CBE
  TELEBIRR
  MOBILE_BANKING
  OTHER
}

enum SupplierType {
  INJERA
  MILK
  GENERAL
}

enum LoanType {
  SALARY_ADVANCE
  STAFF_LOAN
  EMPLOYEE
  CUSTOMER
}

enum LoanStatus {
  PENDING_APPROVAL
  OPEN
  PAID
  REJECTED
}

enum ApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  PRODUCTION_USAGE
}

enum StockPurchaseLoanStatus {
  UNPAID
  PARTIAL
  PAID
}

/// P&L / reporting grouping (separate from ProductCategory = catalog)
enum FinancialCategoryType {
  REVENUE
  EXPENSE
}

model Company {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branches  Branch[]

  @@unique([name])
}

model Branch {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  users     User[]
  stockItems StockItem[]
  productionBatches ProductionBatch[]
  productConversions ProductConversion[]
  dailySessions DailySession[]
  suppliers Supplier[]
  expenses Expense[]
  loans Loan[]

  @@index([companyId])
}

model User {
  id            String    @id @default(cuid())
  fullName      String
  phone         String?   @unique   // Login and identity (required for new users; set for existing to allow login)
  passwordHash  String
  role          Role      // OWNER/ADMIN = more privileges; BAKER, CASHIER, SAMBUSA_WORKER = staff
  branchId      String?
  isActive      Boolean   @default(true)
  // Salary / billing (all users are staff; optional for OWNER/ADMIN if not paid via payroll)
  salary        Decimal?  @db.Decimal(12, 2)
  startDate     DateTime?
  lastPaidDate  DateTime?
  shift         Shift?
  filesUrl      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  branch        Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]
  stockPurchasePayments StockPurchasePayment[]
  productionBatches ProductionBatch[]
  productConversions ProductConversion[]
  sales Sale[]
  expenses Expense[]
  penalties     Penalty[]
  payrollRecords PayrollRecord[]
  loansAsBorrower Loan[]  @relation("EmployeeLoans")
  passwordResetRequests PasswordResetRequest[]
}

model ProductCategory {
  id        String           @id @default(cuid())
  name      String
  type      CategoryType
  parentId  String?
  parent    ProductCategory? @relation("ProductCategoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children  ProductCategory[] @relation("ProductCategoryChildren")
  products Product[]

  @@index([parentId])
}

model FinancialCategory {
  id        String               @id @default(cuid())
  name      String
  type      FinancialCategoryType
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  products  Product[]
  expenses  Expense[]

  @@unique([name, type])
}

model Product {
  id                    String             @id @default(cuid())
  categoryId            String
  category              ProductCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  financialCategoryId   String?
  financialCategory     FinancialCategory? @relation(fields: [financialCategoryId], references: [id], onDelete: SetNull)
  name                  String
  flavor                String?
  unitType              UnitType
  basePrice             Decimal            @db.Decimal(12, 2)
  buyPrice              Decimal?           @db.Decimal(12, 2)
  imageUrl              String?
  isActive              Boolean            @default(true)
  createdAt             DateTime           @default(now())
  productionItems       ProductionItem[]
  saleItems             SaleItem[]
  leftoverRecords       LeftoverRecord[]
  supplierDeliveries    SupplierDelivery[]
  conversionsFrom       ProductConversion[] @relation("FromProduct")
  conversionsTo         ProductConversion[] @relation("ToProduct")

  @@index([financialCategoryId])
}

model StockItem {
  id              String   @id @default(cuid())
  branchId        String
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name            String
  unitType        UnitType
  currentQuantity Decimal  @db.Decimal(12, 3)
  unitPrice       Decimal? @default(0) @db.Decimal(12, 2)
  minStockLevel   Decimal? @db.Decimal(12, 3)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  movements       StockMovement[]
  productionMaterialUsages ProductionMaterialUsage[]

  @@index([branchId])
}

model StockMovement {
  id           String             @id @default(cuid())
  stockItemId  String
  stockItem    StockItem          @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  quantity     Decimal            @db.Decimal(12, 3)
  unitPrice    Decimal?           @db.Decimal(12, 2)
  totalValue   Decimal?           @db.Decimal(12, 2)
  type         StockMovementType
  reason       String?
  purchaseLoan StockPurchaseLoan?
  createdAt    DateTime           @default(now())

  @@index([stockItemId])
  @@index([userId])
  @@index([createdAt])
}

model StockPurchaseLoan {
  id               String                  @id @default(cuid())
  stockMovementId String                  @unique
  stockMovement   StockMovement           @relation(fields: [stockMovementId], references: [id], onDelete: Cascade)
  stockItemId      String
  branchId         String
  supplierName     String?
  totalAmount      Decimal                 @db.Decimal(12, 2)
  paidAmount       Decimal                 @default(0) @db.Decimal(12, 2)
  remainingBalance Decimal                 @db.Decimal(12, 2)
  status           StockPurchaseLoanStatus @default(UNPAID)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  payments         StockPurchasePayment[]

  @@index([stockItemId])
  @@index([branchId])
  @@index([status])
}

model StockPurchasePayment {
  id        String            @id @default(cuid())
  loanId    String
  loan      StockPurchaseLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  amount    Decimal           @db.Decimal(12, 2)
  note      String?
  createdAt DateTime          @default(now())

  @@index([loanId])
  @@index([userId])
}

model ProductionBatch {
  id        String      @id @default(cuid())
  branchId  String
  branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessionId String?
  session   DailySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  date      DateTime    @db.Date   @default(dbgenerated("CURRENT_DATE"))  // Day this production is for (flexible; can be past)
  shift     Shift?
  status    BatchStatus @default(STARTED)
  createdAt DateTime    @default(now())
  items     ProductionItem[]
  materialUsages ProductionMaterialUsage[]

  @@index([branchId, date])
  @@index([branchId, status])
  @@index([sessionId])
}

model ProductionItem {
  id                String          @id @default(cuid())
  batchId           String
  batch             ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantityProduced  Int
  returnedQuantity  Int             @default(0)
  createdAt         DateTime        @default(now())
}

model ProductionMaterialUsage {
  id            String          @id @default(cuid())
  batchId       String
  batch         ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  stockItemId   String
  stockItem     StockItem       @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  quantityUsed  Decimal         @db.Decimal(12, 3)
  createdAt     DateTime        @default(now())

  @@index([batchId])
  @@index([stockItemId])
}

model ProductConversion {
  id            String   @id @default(cuid())
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  fromProductId String
  fromProduct   Product  @relation("FromProduct", fields: [fromProductId], references: [id], onDelete: Restrict)
  toProductId   String
  toProduct     Product  @relation("ToProduct", fields: [toProductId], references: [id], onDelete: Restrict)
  fromQuantity  Int
  toQuantity    Int
  createdAt     DateTime @default(now())
}

model DailySession {
  id           String        @id @default(cuid())
  branchId     String
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  date         DateTime      @db.Date   // Calendar day; opens at 00:00, ends after 24h; can register for any day (incl. past)
  status       SessionStatus @default(OPEN)
  label              String?   // Optional session label e.g. "Morning Shift", "Shift A"
  openingCashFloat   Decimal? @db.Decimal(12, 2)
  cashLeftoverAmount Decimal? @db.Decimal(12, 2)
  actualCashAmount   Decimal? @db.Decimal(12, 2)
  actualCbeAmount    Decimal? @db.Decimal(12, 2)
  actualTelebirrAmount Decimal? @db.Decimal(12, 2)
  notes              String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sales        Sale[]
  expenses     Expense[]
  supplierDeliveries SupplierDelivery[]
  leftoverRecords LeftoverRecord[]
  productionBatches ProductionBatch[]
  @@unique([branchId, date])
}

model Sale {
  id            String    @id @default(cuid())
  sessionId     String
  session       DailySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  totalAmount   Decimal   @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH)
  createdAt     DateTime  @default(now())
  items         SaleItem[]
  @@index([userId])
  @@index([createdAt])
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  subtotal  Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([productId])
}

model LeftoverRecord {
  id               String        @id @default(cuid())
  sessionId        String
  session          DailySession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantityRemaining Int
  damagedQuantity   Int           @default(0)
  damageReason      String?
  recordedAt       DateTime      @default(now())
  @@unique([sessionId, productId])
}

model Supplier {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  type      SupplierType
  createdAt DateTime @default(now())
  deliveries SupplierDelivery[]
}

model SupplierDelivery {
  id               String     @id @default(cuid())
  supplierId       String
  supplier         Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId        String
  product          Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantityReceived Int
  unitBuyPrice     Decimal    @db.Decimal(12, 2)
  unitSellPrice   Decimal    @db.Decimal(12, 2)
  sessionId        String?
  session          DailySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  isPaid           Boolean    @default(false)
  returnedQuantity Int        @default(0)
  createdAt        DateTime   @default(now())

  @@index([supplierId])
  @@index([createdAt])
  @@index([sessionId])
}

/// COMPANY = business / operating; OWNER = owner withdrawal (excluded from daily operating totals in analytics)
enum ExpenseType {
  COMPANY
  OWNER
}

model Expense {
  id                    String             @id @default(cuid())
  branchId              String
  branch                Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId                String
  user                  User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  type                  ExpenseType        @default(COMPANY)
  financialCategoryId   String?
  financialCategory     FinancialCategory? @relation(fields: [financialCategoryId], references: [id], onDelete: SetNull)
  sessionId             String?
  session               DailySession?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  amount                Decimal            @db.Decimal(12, 2)
  category              String             // RENT, SALARY, LUNCH, SUPPLIER, EKUB, UTILITIES, OTHER (legacy label; prefer financialCategoryId)
  description           String?
  date                  DateTime           @db.Date
  createdAt             DateTime           @default(now())

  @@index([branchId, date])
  @@index([userId])
  @@index([financialCategoryId])
  @@index([sessionId])
}

model Loan {
  id               String     @id @default(cuid())
  branchId         String
  branch           Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  type             LoanType   // EMPLOYEE => userId; CUSTOMER => entityId (customer name/phone)
  entityId         String?    // For CUSTOMER loans (customer identifier)
  userId           String?    // For EMPLOYEE loans (the user/employee who borrowed)
  user             User?     @relation("EmployeeLoans", fields: [userId], references: [id], onDelete: SetNull)
  totalAmount      Decimal    @db.Decimal(12, 2)
  remainingBalance Decimal    @db.Decimal(12, 2)
  status           LoanStatus @default(OPEN)
  date             DateTime   @db.Date   @default(dbgenerated("CURRENT_DATE"))
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  payments         LoanPayment[]

  @@index([branchId])
}

model LoanPayment {
  id        String   @id @default(cuid())
  loanId    String
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  amountPaid Decimal @db.Decimal(12, 2)
  date      DateTime @db.Date
  createdAt DateTime @default(now())
}

model Penalty {
  id         String         @id @default(cuid())
  userId     String         // User (staff) the penalty applies to
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Decimal        @db.Decimal(12, 2)
  reason     String
  date       DateTime       @db.Date
  status     ApprovalStatus @default(PENDING_APPROVAL)
  isDeducted Boolean        @default(false)
  createdAt  DateTime       @default(now())

  @@index([userId])
}

model PayrollRecord {
  id                String   @id @default(cuid())
  userId            String   // User (staff) this payroll is for
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month             Int
  year              Int
  baseSalary        Decimal  @db.Decimal(12, 2)
  loanDeductions    Decimal  @db.Decimal(12, 2) @default(0)
  penaltyDeductions Decimal  @db.Decimal(12, 2) @default(0)
  bonus             Decimal  @db.Decimal(12, 2) @default(0)
  finalAmount       Decimal  @db.Decimal(12, 2)
  paymentDate       DateTime?
  createdAt         DateTime @default(now())
  @@unique([userId, month, year])
}

enum ResetRequestStatus {
  PENDING
  RESOLVED
  REJECTED
}

model PasswordResetRequest {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone            String
  status           ResetRequestStatus @default(PENDING)
  requestedAt      DateTime           @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?

  @@index([userId])
  @@index([status])
}
